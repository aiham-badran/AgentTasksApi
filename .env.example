# ─── App ─────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database ────────────────────────────────
DATABASE_URL=./data/app.db

# ─── Auth ────────────────────────────────────
JWT_SECRET=change_me_to_minimum_32_characters_please
JWT_EXPIRES_IN=7d

# ─── Encryption (BYOK) ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=replace_with_base64_32_bytes

# ─── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100